# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

COMUNIO_USERNAME=
COMUNIO_PASSWORD=

# Optional. IANA timezone; drives the x-timezone header and the tzoffset sent on login.
# COMUNIO_TIMEZONE=Europe/Madrid

# Optional. Defaults to the captured browser user agent; override only if the API starts
# refusing it.
# COMUNIO_USER_AGENT=

# Optional. Where proposals are stored inside the container. Mount a volume there to keep
# them, and their audit trail, across restarts.
# COMUNIO_STATE_DIR=/data
